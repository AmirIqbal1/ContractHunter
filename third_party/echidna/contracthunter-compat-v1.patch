+-- Exit 0: all properties held within a completed budget; exit 1: a concrete
+-- counterexample and no ambiguous property; exit 2: incomplete or failed.
+encodeCampaign :: Env -> [(Maybe WorkerStopReason, WorkerState)] -> IO (L.ByteString, Int)
+encodeCampaign env workers = do
+  observedTests <- traverse readIORef env.testRefs
+  let reasons = fst <$> workers
+      states = snd <$> workers
+      calls = sum $ (.ncalls) <$> states
+      budget = env.cfg.campaignConf.testLimit
+      cleanTests = all (\test -> case test.state of
+        T.Large _ -> False
+        T.Failed _ -> False
+        _ -> True) observedTests
+      completed = budget > 0 && not (null reasons) && all isTestLimit reasons
+        && calls >= budget && cleanTests
+      normallyStopped = not (null reasons) && all isNormalStop reasons
+      mapped = traverse (mapTest completed normallyStopped) observedTests
+      errorMessage = case mapped of
+        Nothing -> Just "unsupported-test-type"
+        Just [] -> Just "no-property-tests"
+        Just _ -> Nothing
+      workerSeed [] = 0
       workerSeed (state:_) = state.genDict.defSeed
-  let seed = workerSeed workerStates
-  pure $ encode Campaign
-    { _success = True
-    , _error = Nothing
-    , _tests = mapTest env.dapp <$> tests
-    , seed = seed
-    , coverage = Map.mapKeys (("0x" ++) . (`showHex` "")) $ VU.toList <$> frozenCov
+      exitCode = case (errorMessage, mapped) of
+        (Nothing, Just mappedTests)
+          | any (\test -> test.outcome == "inconclusive" || test.outcome == "execution-failed") mappedTests -> 2
+          | any (\test -> test.outcome == "counterexample-found") mappedTests -> 1
+          | all (\test -> test.outcome == "held-within-bounds") mappedTests -> 0
+        _ -> 2
+  pure (encode Campaign
+    { seed = workerSeed states
+    , configuredTestLimit = budget
+    , executedCalls = calls
+    , workerStopReasons = reasonCode <$> reasons
+    , tests = maybe [] id mapped
+    , campaignError = errorMessage
+    }, exitCode)
+
+isTestLimit :: Maybe WorkerStopReason -> Bool
+isTestLimit (Just TestLimitReached) = True
+isTestLimit _ = False
+
+isNormalStop :: Maybe WorkerStopReason -> Bool
+isNormalStop (Just TestLimitReached) = True
+isNormalStop (Just FastFailed) = True
+isNormalStop _ = False
+
+reasonCode :: Maybe WorkerStopReason -> String
+reasonCode (Just TestLimitReached) = "test-limit-reached"
+reasonCode (Just SymbolicExplorationDone) = "symbolic-exploration-done"
+reasonCode (Just SymbolicVerificationDone) = "symbolic-verification-done"
+reasonCode (Just TimeLimitReached) = "time-limit-reached"
+reasonCode (Just FastFailed) = "fast-failed"
+reasonCode (Just (Killed _)) = "killed"
+reasonCode (Just (Crashed _)) = "crashed"
+reasonCode Nothing = "missing-stop-reason"
+
+mapTest :: Bool -> Bool -> EchidnaTest -> Maybe Test
+mapTest completed normallyStopped test = case test.testType of
+  T.PropertyTest propertyName _ -> Just Test
+    { name = propertyName
+    , outcome = outcome
+    , transactions = if outcome == "counterexample-found"
+                     then Just (mapTx <$> test.reproducer)
+                     else Nothing
     }
+  _ -> Nothing
+  where
+    outcome = case test.state of
+      T.Open | completed -> "held-within-bounds"
+      T.Solved | normallyStopped && not (null test.reproducer) -> "counterexample-found"
+      T.Failed _ -> "execution-failed"
+      _ -> "inconclusive"
 
